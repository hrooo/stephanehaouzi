# ─── Base Postgres ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coupe_du_monde

# ─── Auth maison ──────────────────────────────────────────────
# Secret pour signer les cookies de session (32+ caractères aléatoires)
# Génère-en un avec : openssl rand -base64 32
AUTH_SECRET=remplace-moi-par-un-secret-aleatoire-32-caracteres-min

# ─── Auto-sync des résultats (football-data.org) ──────────────
# Inscris-toi gratuitement : https://www.football-data.org/client/register
# Tier "Free" = 10 req/min, suffisant pour un cron toutes les 15 min.
FOOTBALL_DATA_API_KEY=

# Secret partagé pour les appels cron à /api/sync-results.
# Vercel ajoute automatiquement Authorization: Bearer ${CRON_SECRET}
# Génère-en un avec : openssl rand -base64 32
CRON_SECRET=
